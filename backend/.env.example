# HTTP
SCOREHUB_ADDR=:8080

# Database
SCOREHUB_DB_DSN=postgres://postgres:scorehub@localhost:5432/scorehub?sslmode=disable

# Auth
SCOREHUB_TOKEN_SECRET=change-me-in-dev
SCOREHUB_DEV_AUTH=true

# WeChat (可选)
SCOREHUB_WECHAT_APPID=
SCOREHUB_WECHAT_SECRET=

# Reverse Geocode (可选，用于定位名称反查；若同时配置，优先腾讯，其次高德，最后百度)
# Tencent Map
SCOREHUB_TENCENT_MAP_KEY=

# Amap / Gaode Map
SCOREHUB_AMAP_KEY=

# Baidu Map (AK)
SCOREHUB_BAIDU_MAP_AK=

# TTS (可选，供小程序/H5统一播放；当前后端按 OpenAI 兼容的 POST /audio/speech 调用)
#
# 字段说明：
# SCOREHUB_TTS_API_BASE        TTS 服务基础地址，不要带具体接口路径。
#                              例：https://api.siliconflow.cn/v1
# SCOREHUB_TTS_API_SPEECH_PATH 语音合成接口路径，默认 /audio/speech。
# SCOREHUB_TTS_API_VOICES_PATH 语音列表接口路径；只有上游本身提供 voices 接口时才需要。
# SCOREHUB_TTS_VOICES_JSON     推荐配置。由后端自己维护要暴露给前端的声音列表 JSON。
#                              每项支持 id / label / providerVoice / language / description / isDefault。
# SCOREHUB_TTS_API_KEY         服务商 API Key，后端会按 Authorization: Bearer <key> 发送。
# SCOREHUB_TTS_MODEL           TTS 模型名，由服务商定义。
# SCOREHUB_TTS_AUDIO_FORMAT    输出音频格式，当前建议 mp3；也支持 wav。
# SCOREHUB_TTS_DEFAULT_VOICE   默认 voice id；若 VOICES_JSON 或上游列表里已标记默认项，可留空。
#
# SiliconFlow 示例：
# SCOREHUB_TTS_API_BASE=https://api.siliconflow.cn/v1
# SCOREHUB_TTS_API_SPEECH_PATH=/audio/speech
# SCOREHUB_TTS_API_KEY=your_api_key
# SCOREHUB_TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# SCOREHUB_TTS_AUDIO_FORMAT=mp3
# SCOREHUB_TTS_VOICES_JSON=[{"id":"warm","label":"温柔","providerVoice":"FunAudioLLM/CosyVoice2-0.5B:claire","description":"温柔女声","isDefault":true},{"id":"bright","label":"清亮","providerVoice":"FunAudioLLM/CosyVoice2-0.5B:diana","description":"清亮女声"},{"id":"steady","label":"沉稳","providerVoice":"FunAudioLLM/CosyVoice2-0.5B:anna","description":"沉稳女声"}]
# SCOREHUB_TTS_DEFAULT_VOICE=warm
#
# 本地 MeloTTS sidecar 示例：
# SCOREHUB_TTS_API_BASE=http://melo-tts:18090/v1
# SCOREHUB_TTS_API_SPEECH_PATH=/audio/speech
# SCOREHUB_TTS_API_VOICES_PATH=/audio/voices
# SCOREHUB_TTS_API_KEY=local
# SCOREHUB_TTS_MODEL=melo-zh
# SCOREHUB_TTS_AUDIO_FORMAT=wav
# SCOREHUB_TTS_DEFAULT_VOICE=warm
#
# 前端始终通过后端 /api/v1/voice/voices 动态拉取声音列表；不再走固定 warm/bright/steady 环境变量。
SCOREHUB_TTS_API_BASE=
SCOREHUB_TTS_API_SPEECH_PATH=/audio/speech
SCOREHUB_TTS_API_VOICES_PATH=/audio/voices
SCOREHUB_TTS_VOICES_JSON=
SCOREHUB_TTS_API_KEY=
SCOREHUB_TTS_MODEL=
SCOREHUB_TTS_AUDIO_FORMAT=mp3
SCOREHUB_TTS_DEFAULT_VOICE=
